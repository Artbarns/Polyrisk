<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
>
    <!-- Connect Stylesheet -->
    <Style src="project://database/Assets/UI/Styles/Theme.uss" />

    <ui:VisualElement class="bottom-panel-container">
        <!-- Main Panel Structure -->
        <ui:VisualElement class="marketplace-panel">
            
            <!-- Handle Indicator -->
            <ui:VisualElement class="indicator-row">
                <ui:VisualElement class="indicator-pill" />
            </ui:VisualElement>

            <!-- Close Button Overlay -->
            <ui:Button class="btn-close" name="Btn_Close">
                <ui:Label text="×" class="close-text" />
            </ui:Button>

            <!-- Card Content Wrapper -->
            <ui:VisualElement class="panel-content">

                <!-- AUCTION CHOICE CARD -->
                <ui:Button class="card-choice card-auction" name="Btn_InitiateTender">
                    <ui:VisualElement class="icon-box icon-auction-box">
                        <!-- We map the PNG sprite created later onto this VisualElement -->
                        <ui:VisualElement class="icon-image icon-chart-png" />
                    </ui:VisualElement>
                    
                    <ui:VisualElement class="text-stack">
                        <ui:Label text="SELL A PROPERTY" class="card-title" />
                        <ui:Label text="Invite offers in cash, properties, or both." class="card-desc" />
                    </ui:VisualElement>
                </ui:Button>

                <!-- OR DIVIDER -->
                <ui:VisualElement class="or-divider">
                    <ui:VisualElement class="divider-line" />
                    <ui:Label text="OR" class="divider-text" />
                    <ui:VisualElement class="divider-line" />
                </ui:VisualElement>

                <!-- SANCTIONS CHOICE CARD -->
                <ui:Button class="card-choice card-sanctions" name="Btn_Sanctions">
                    <ui:VisualElement class="icon-box icon-sanctions-box">
                        <ui:VisualElement class="icon-image icon-wrench-png" />
                    </ui:VisualElement>
                    
                    <ui:VisualElement class="text-stack">
                        <ui:Label text="HOSTILE SANCTIONS" class="card-title" />
                        <ui:Label text="Target rivals with economic penalties." class="card-desc" />
                    </ui:VisualElement>
                </ui:Button>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

</ui:UXML>
