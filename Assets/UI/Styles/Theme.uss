/* 
* Theme.uss - General styling for PolyRisk Mobile UI 
* Translated from React Tailwind spacing, colors, and borders to 1920x1080px (9:16 relative) scale.
*/

:root {
    /* Main Panel Background — Cyber-Luxury dark */
    --color-panel-bg-top: rgba(15, 17, 25, 0.96);
    --color-panel-bg-bot: rgba(18, 20, 28, 0.96);
    --color-panel-border: rgba(64, 65, 78, 1);

    /* Texts */
    --color-text-white: #ffffff;
    --color-text-muted: #d1d5dc;
    --color-text-darker: #99a1af;

    /* Neon Accents — Cyber-Luxury palette */
    --color-neon-green: #05DF72;
    --color-neon-cyan: #00FFFF;
    --color-neon-purple: #C27AFF;
    --color-neon-orange: #F59E0B;
    --color-neon-red: #FF4747;
    --color-neon-gold: #FFD700;

    /* Green Card Constants (Cash / Auction) */
    --color-auction-bg: rgba(5, 223, 114, 0.18);
    --color-auction-border: rgba(5, 223, 114, 0.45);

    /* Purple Card Constants (Property / Sanctions) */
    --color-sanctions-bg: rgba(194, 122, 255, 0.18);
    --color-sanctions-border: rgba(194, 122, 255, 0.4);
    --color-sanctions-bg-light: rgba(194, 122, 255, 0.1);

    /* Dark Board WealthStatus colors */
    --color-wealth-low:   #8A8F9A;
    --color-wealth-mid:   #3B82F6;
    --color-wealth-high:  #F59E0B;
    --color-wealth-mogul: #FFD700;

    /* Misc */
    --color-handle-pill: #3b3d4a;
}

/* ═══════════════════════════════════════════════════
   HOME + ONLINE LOBBY
═══════════════════════════════════════════════════ */

.main-menu-overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 7, 12, 0.97);
    padding: 24px;
}

.main-menu-card {
    -unity-font: url("/Assets/UI/Fonts/Inter-400.ttf");
    width: 100%;
    max-width: 520px;
    max-height: 92%;
    padding: 28px;
    background-color: rgba(15, 17, 25, 0.98);
    border-width: 1px;
    border-color: rgba(120, 125, 145, 0.45);
    border-radius: 24px;
}

.main-menu-card Button { -unity-font: url("/Assets/UI/Fonts/Inter-600.ttf"); }

#HomeView .unity-scroller--vertical {
    width: 10px;
    min-width: 10px;
    background-color: rgba(7, 9, 14, 0.7);
}
#HomeView .unity-scroller #unity-low-button,
#HomeView .unity-scroller #unity-high-button { display: none; }
#HomeView .unity-scroller #unity-tracker { background-color: rgba(39, 43, 53, 1); }
#HomeView .unity-scroller #unity-dragger {
    background-color: rgba(120, 125, 145, 0.5);
    border-radius: 4px;
    min-height: 24px;
}
#HomeView .unity-scroll-view__content-container > Button { flex-shrink: 0; }

.main-menu-title {
    -unity-font: url("/Assets/UI/Fonts/Inter-700.ttf");
    color: var(--color-neon-green);
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 5px;
    margin-bottom: 6px;
}

.main-menu-kicker,
.main-menu-help,
.lobby-status {
    -unity-font: url("/Assets/UI/Fonts/Inter-600.ttf");
    color: var(--color-text-darker);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1.5px;
    margin-bottom: 20px;
}

.main-menu-input {
    margin-bottom: 14px;
}

.main-menu-input Label,
.main-menu-code-input Label {
    -unity-font: url("/Assets/UI/Fonts/Inter-600.ttf");
    color: var(--color-text-darker);
    font-size: 10px;
    -unity-font-style: bold;
    min-width: 100px;
}

.main-menu-input TextInput,
.main-menu-code-input TextInput {
    min-height: 46px;
    color: var(--color-text-white);
    background-color: rgba(7, 9, 14, 0.9);
    border-width: 1px;
    border-color: rgba(120, 125, 145, 0.45);
    border-radius: 10px;
    padding-left: 12px;
    padding-right: 12px;
}

.main-menu-primary {
    margin-top: 4px;
    margin-bottom: 12px;
}

.main-menu-motion {
    min-height: 44px;
    margin-top: 8px;
    margin-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    color: var(--color-text-muted);
    font-size: 12px;
    background-color: rgba(7, 9, 14, 0.72);
    border-width: 1px;
    border-color: rgba(120, 125, 145, 0.35);
    border-radius: 10px;
}

.main-menu-motion .unity-toggle__input {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    background-color: transparent;
    border-width: 0;
}

.main-menu-motion .unity-toggle__checkmark {
    width: 22px;
    height: 22px;
    background-color: rgba(39, 43, 53, 1);
    border-width: 1px;
    border-color: rgba(120, 125, 145, 0.6);
    border-radius: 6px;
}

.main-menu-motion:checked .unity-toggle__checkmark {
    background-color: var(--color-neon-green);
    border-color: var(--color-neon-green);
}

.ux-reduced-motion .activity-feed-item {
    transition-duration: 0ms;
}

.main-menu-join-row,
.main-menu-actions {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 12px;
}

.main-menu-code-input {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 10px;
}

.main-menu-connection {
    color: var(--color-text-darker);
    margin-top: 14px;
    font-size: 10px;
}

.lobby-code {
    color: var(--color-neon-green);
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 8px;
    margin-bottom: 6px;
}

.lobby-status {
    color: var(--color-neon-purple);
    margin-top: 4px;
    margin-bottom: 10px;
}

.lobby-player-list {
    min-height: 168px;
    max-height: 310px;
    margin-bottom: 16px;
}

.lobby-player-row {
    min-height: 46px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 14px;
    padding-right: 14px;
    margin-bottom: 6px;
    background-color: rgba(7, 9, 14, 0.78);
    border-width: 1px;
    border-color: rgba(120, 125, 145, 0.28);
    border-radius: 10px;
}

.lobby-player-row--local {
    border-color: rgba(5, 223, 114, 0.65);
}

.lobby-player-name {
    color: var(--color-text-white);
    font-size: 13px;
    -unity-font-style: bold;
}

.lobby-player-ready,
.lobby-player-waiting {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.lobby-player-ready { color: var(--color-neon-green); }
.lobby-player-waiting { color: var(--color-text-darker); }

.main-menu-actions > Button {
    flex-grow: 1;
    margin-left: 4px;
    margin-right: 4px;
}

.btn-ghost {
    min-height: 44px;
    color: var(--color-text-darker);
    background-color: transparent;
    border-width: 0;
    -unity-font-style: bold;
}

.btn-ghost:hover,
.btn-ghost:focus {
    color: var(--color-text-white);
    background-color: rgba(255, 255, 255, 0.06);
}

.main-menu-error {
    position: absolute;
    bottom: 20px;
    max-width: 520px;
    color: #ffffff;
    background-color: rgba(150, 25, 35, 0.96);
    border-radius: 10px;
    padding: 10px 16px;
    -unity-text-align: middle-center;
}

.ux-narrow .main-menu-card {
    padding: 18px;
    border-radius: 18px;
}

.ux-narrow .main-menu-title { font-size: 34px; }
.ux-narrow .lobby-code { font-size: 34px; }
.ux-narrow .main-menu-join-row {
    flex-direction: column;
    align-items: stretch;
}
.ux-narrow .main-menu-code-input {
    flex-grow: 0;
    flex-basis: auto;
    width: 100%;
    margin-right: 0;
    margin-bottom: 10px;
}
.ux-compact-height .main-menu-overlay { padding: 8px 16px; }
.ux-compact-height .main-menu-card {
    max-width: 720px;
    max-height: 98%;
    padding: 10px 20px;
}
.ux-compact-height .main-menu-title { font-size: 26px; margin-bottom: 0; }
.ux-compact-height .main-menu-kicker,
.ux-compact-height .main-menu-help { margin-bottom: 5px; }
.ux-compact-height .main-menu-input { margin-bottom: 5px; }
.ux-compact-height .main-menu-input TextInput,
.ux-compact-height .main-menu-code-input TextInput { min-height: 34px; }
.ux-compact-height .main-menu-primary { margin-top: 2px; margin-bottom: 5px; }
.ux-compact-height .main-menu-join-row,
.ux-compact-height .main-menu-actions { margin-bottom: 5px; }
.ux-compact-height .main-menu-card > Button,
.ux-compact-height #HomeView .unity-scroll-view__content-container > Button,
.ux-compact-height .main-menu-join-row > Button,
.ux-compact-height .main-menu-actions > Button {
    min-height: 38px;
    padding-top: 6px;
    padding-bottom: 6px;
}
.ux-compact-height .main-menu-connection { margin-top: 4px; }
/* Keep the lobby actions below its scroll viewport on short logical panels. */
.ux-compact-height .lobby-code {
    font-size: 28px;
    letter-spacing: 5px;
    margin-bottom: 2px;
}
.ux-compact-height .lobby-status { margin-top: 2px; margin-bottom: 4px; }
.ux-compact-height .lobby-player-list {
    min-height: 84px;
    max-height: 112px;
    margin-bottom: 6px;
}
.ux-compact-height .lobby-player-row { min-height: 36px; margin-bottom: 4px; }
.ux-compact-height .main-menu-actions { flex-shrink: 0; min-height: 38px; }
.ux-compact-height .main-menu-card > .btn-ghost { flex-shrink: 0; }

/* Short landscape panels keep actions and leaving the lobby reachable. */
.ux-low-height .main-menu-card { padding: 8px 16px; }
.ux-low-height .main-menu-kicker,
.ux-low-height .main-menu-help { display: none; }
.ux-low-height .main-menu-title { font-size: 22px; }
.ux-low-height .lobby-player-list { min-height: 40px; max-height: 64px; }
.ux-low-height .lobby-code { font-size: 24px; }


/* ═══════════════════════════════════════════════════
   TOP HUD — Barre fixée en haut (Cyber-Luxury)
═══════════════════════════════════════════════════ */

.top-hud-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(10, 12, 18, 0.92);
    border-bottom-width: 1px;
    border-color: rgba(64, 65, 78, 0.45);
}

.top-hud-segment {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.top-hud-label {
    -unity-font: url("/Assets/UI/Fonts/Inter-500.ttf");
    color: var(--color-text-darker);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 3px;
    -unity-text-align: middle-center;
}

.top-hud-value {
    -unity-font: url("/Assets/UI/Fonts/Inter-700.ttf");
    color: var(--color-text-white);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: clip;
}

.top-hud-value--green  { color: var(--color-neon-green); }
.top-hud-value--purple { color: var(--color-neon-purple); }
.top-hud-value--cyan   { color: var(--color-neon-cyan); }
.top-hud-value--orange { color: var(--color-neon-orange); }
.top-hud-value--red    { color: var(--color-neon-red); }

.top-hud-separator {
    width: 1px;
    min-width: 1px;
    height: 28px;
    background-color: rgba(120, 125, 145, 0.45);
    flex-shrink: 0;
    margin-left: 4px;
    margin-right: 4px;
}

/* Compact shared activity: two self-expiring rows, no textures or layout polling. */
.activity-feed {
    position: absolute;
    top: 65px;
    left: 12px;
    right: 12px;
    width: auto;
    min-width: 0;
    max-width: none;
    display: none;
}

.activity-feed-kicker {
    display: none;
    color: rgba(209, 213, 220, 0.72);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
    -unity-text-align: upper-right;
    margin-right: 4px;
    margin-bottom: 4px;
}

.activity-feed-stack {
    flex-direction: row;
    align-items: stretch;
}

.activity-feed-item {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 30px;
    margin-left: 2px;
    margin-right: 2px;
    margin-bottom: 4px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 12px;
    padding-right: 12px;
    color: var(--color-text-white);
    background-color: rgba(10, 12, 18, 0.92);
    border-left-width: 3px;
    border-color: var(--color-neon-cyan);
    border-radius: 9px;
    font-size: 11px;
    -unity-font-style: bold;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate, scale;
    transition-duration: 220ms;
    transition-timing-function: ease-out-cubic;
}

.activity-feed-item--purchase { border-color: var(--color-neon-green); }
.activity-feed-item--rent,
.activity-feed-item--tax { border-color: var(--color-neon-red); }
.activity-feed-item--upgrade,
.activity-feed-item--income { border-color: var(--color-neon-green); }
.activity-feed-item--casino { border-color: var(--color-neon-orange); }
.activity-feed-item--pass { border-color: var(--color-text-darker); color: var(--color-text-muted); }
.activity-feed-item--audit,
.activity-feed-item--bankruptcy,
.activity-feed-item--marketplace { border-color: var(--color-neon-red); }
.activity-feed-item--power,
.activity-feed-item--family,
.activity-feed-item--venture { border-color: var(--color-neon-purple); }
.activity-feed-item--investment { border-color: var(--color-neon-cyan); }
.activity-feed-item--cycle { border-color: var(--color-neon-orange); }
.activity-feed-item--emphasis {
    background-color: rgba(194, 122, 255, 0.18);
    border-left-width: 5px;
}
.activity-feed-item--enter { opacity: 0; translate: 28px 0; scale: 0.98 0.98; }
.activity-feed-item--exit { opacity: 0; translate: 18px 0; }

.ux-narrow .activity-feed {
    left: 10px;
    right: 10px;
    width: auto;
    min-width: 0;
    max-width: none;
}

.ux-narrow .activity-feed-stack {
    flex-direction: column;
}

.ux-compact-height .activity-feed { top: 65px; }
.ux-compact-height .activity-feed-item {
    min-height: 32px;
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 11px;
}

/* ═══════════════════════════════════════════════════
   DARK BOARD — Pastille WealthStatus
═══════════════════════════════════════════════════ */

.wealth-pill {
    flex-direction: row;
    align-items: center;
    border-radius: 999px;
    border-width: 1.5px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(0, 0, 0, 0.45);
}

.wealth-pill--low   { border-color: var(--color-wealth-low);   }
.wealth-pill--mid   { border-color: var(--color-wealth-mid);   }
.wealth-pill--high  { border-color: var(--color-wealth-high);  }
.wealth-pill--mogul { border-color: var(--color-wealth-mogul); }

.wealth-pill-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 8px;
}

.wealth-pill-dot--low   { background-color: var(--color-wealth-low);   }
.wealth-pill-dot--mid   { background-color: var(--color-wealth-mid);   }
.wealth-pill-dot--high  { background-color: var(--color-wealth-high);  }
.wealth-pill-dot--mogul { background-color: var(--color-wealth-mogul); }

.wealth-pill-label {
    color: var(--color-text-white);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.wealth-pill-label--low   { color: var(--color-wealth-low);   }
.wealth-pill-label--mid   { color: var(--color-wealth-mid);   }
.wealth-pill-label--high  { color: var(--color-wealth-high);  }
.wealth-pill-label--mogul { color: var(--color-wealth-mogul); }

/* ═══════════════════════════════════════════════════
   PHASE E.5 — TRANSITIONS (Cyber-Luxury motion)
═══════════════════════════════════════════════════ */

/* Bottom sheets : slide-up depuis le bas + fade-in */
.marketplace-panel {
    transition-property: translate, opacity;
    transition-duration: 280ms;
    transition-timing-function: ease-out-cubic;
    translate: 0 0;
    opacity: 1;
}

.marketplace-panel.panel-enter-from {
    translate: 0 100%;
    opacity: 0;
}

.marketplace-panel.panel-exit-to {
    translate: 0 100%;
    opacity: 0;
    transition-duration: 200ms;
    transition-timing-function: ease-in-cubic;
}

/* Modales centrées (notifications) : scale + fade */
.marketplace-notification-container {
    transition-property: scale, opacity;
    transition-duration: 240ms;
    transition-timing-function: ease-out-cubic;
    scale: 1 1;
    opacity: 1;
}

.marketplace-notification-container.modal-enter-from {
    scale: 0.85 0.85;
    opacity: 0;
}

.auction-countdown {
    align-self: center;
    min-width: 64px;
    padding: 6px 12px;
    margin-bottom: 12px;
    border-radius: 16px;
    background-color: rgba(255, 170, 0, 0.12);
    color: #FFB547;
    -unity-font: url("/Assets/UI/Fonts/Inter-700.ttf");
    font-size: 18px;
    -unity-text-align: middle-center;
}

.auction-countdown--critical {
    background-color: rgba(255, 83, 83, 0.16);
    color: #FF6868;
}

/* Fullscreen overlays (victory/bankruptcy) : fade global */
.fullscreen-overlay {
    transition-property: opacity;
    transition-duration: 350ms;
    transition-timing-function: ease-out-cubic;
    opacity: 1;
}

.fullscreen-overlay.modal-enter-from {
    opacity: 0;
}

/* Pulse glow pour highlights critiques (énergie 100%, victoire imminente) */
.pulse-glow {
    transition-property: opacity, scale;
    transition-duration: 800ms;
    transition-timing-function: ease-in-out;
}

.pulse-glow.glow-on {
    opacity: 1;
    scale: 1.04 1.04;
}

.pulse-glow.glow-off {
    opacity: 0.6;
    scale: 1 1;
}

/* Tap feedback léger sur boutons interactifs */
.tap-feedback {
    transition-property: scale, opacity;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}

.tap-feedback:hover {
    scale: 1.02 1.02;
}

.tap-feedback:active {
    scale: 0.97 0.97;
    opacity: 0.85;
}

/* ═══════════════════════════════════════════════════
   PHASE E.3 — VICTORY SCREEN (Cyber-Luxury)
═══════════════════════════════════════════════════ */

.victory-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(5, 7, 12, 0.94);
    justify-content: center;
    align-items: center;
    padding-left: 24px;
    padding-right: 24px;
}

.victory-card {
    width: 92%;
    max-width: 560px;
    max-height: 90%;
    background-color: rgba(15, 17, 25, 0.98);
    border-width: 2px;
    border-color: var(--color-neon-gold);
    border-radius: 28px;
    padding-top: 32px;
    padding-bottom: 24px;
    padding-left: 24px;
    padding-right: 24px;
    align-items: center;
}

.victory-title {
    color: var(--color-neon-gold);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.victory-winner {
    color: var(--color-text-white);
    font-size: 32px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.victory-condition {
    color: var(--color-neon-green);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 24px;
    -unity-text-align: middle-center;
}

.victory-stats-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    border-bottom-width: 1px;
    border-color: rgba(64, 65, 78, 0.4);
}

.victory-stats-label {
    color: var(--color-text-darker);
    font-size: 13px;
}

.victory-stats-value {
    color: var(--color-text-white);
    font-size: 16px;
    -unity-font-style: bold;
}

.victory-stats-value--winner {
    color: var(--color-neon-gold);
}

.victory-cta-row {
    flex-direction: row;
    justify-content: center;
    width: 100%;
    margin-top: 24px;
}

.victory-stats-list {
    width: 100%;
    flex-grow: 1;
    min-height: 96px;
    max-height: 300px;
    margin-bottom: 8px;
}

/* ═══════════════════════════════════════════════════
   PHASE E.2 — VENTURE CARD POP-UP (Cyber-Luxury)
═══════════════════════════════════════════════════ */

.venture-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(5, 7, 12, 0.88);
    justify-content: center;
    align-items: center;
    padding-left: 24px;
    padding-right: 24px;
}

.venture-card {
    width: 86%;
    max-width: 360px;
    max-height: 88%;
    background-color: rgba(15, 17, 25, 0.98);
    border-radius: 24px;
    border-width: 2px;
    border-color: rgba(120, 125, 145, 0.45);
    padding-top: 24px;
    padding-bottom: 20px;
    padding-left: 20px;
    padding-right: 20px;
    align-items: center;
    transition-property: scale, opacity, rotate;
    transition-duration: 380ms;
    transition-timing-function: ease-out-cubic;
    scale: 1 1;
    opacity: 1;
    rotate: 0deg;
}

.venture-card--positive { border-color: var(--color-neon-green);  background-color: rgba(5, 223, 114, 0.10); }
.venture-card--negative { border-color: var(--color-neon-red);    background-color: rgba(255, 71, 71, 0.10); }
.venture-card--chaos    { border-color: var(--color-neon-purple); background-color: rgba(194, 122, 255, 0.10); }

.venture-card.card-flip-from {
    scale: 0.6 0.6;
    opacity: 0;
    rotate: -180deg;
}

.venture-tag {
    border-radius: 999px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 12px;
    padding-right: 12px;
    margin-bottom: 12px;
    border-width: 1px;
}

.venture-tag--positive { background-color: rgba(5, 223, 114, 0.18);  border-color: var(--color-neon-green);  }
.venture-tag--negative { background-color: rgba(255, 71, 71, 0.18);  border-color: var(--color-neon-red);    }
.venture-tag--chaos    { background-color: rgba(194, 122, 255, 0.18); border-color: var(--color-neon-purple); }

.venture-tag-label {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

.venture-tag-label--positive { color: var(--color-neon-green);  }
.venture-tag-label--negative { color: var(--color-neon-red);    }
.venture-tag-label--chaos    { color: var(--color-neon-purple); }

.venture-card-title {
    color: var(--color-text-white);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 14px;
    letter-spacing: 0.5px;
    white-space: normal;
}

.venture-card-desc {
    color: var(--color-text-muted);
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    white-space: normal;
    padding-left: 8px;
    padding-right: 8px;
}

.venture-card-id {
    color: var(--color-text-darker);
    font-size: 10px;
    letter-spacing: 1px;
    margin-bottom: 16px;
}

/* ═══════════════════════════════════════════════════
   PHASE E.4 — BANKRUPTCY SCREEN
═══════════════════════════════════════════════════ */

.bankruptcy-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(20, 5, 5, 0.92);
    justify-content: center;
    align-items: center;
    padding-top: 32px;
    padding-bottom: 32px;
    padding-left: 16px;
    padding-right: 16px;
}

.bankruptcy-card {
    width: 96%;
    height: 92%;
    max-height: 92%;
    min-height: 0;
    overflow: hidden;
    background-color: rgba(15, 17, 25, 0.98);
    border-radius: 22px;
    border-width: 2px;
    border-color: var(--color-neon-red);
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 18px;
    padding-right: 18px;
    flex-direction: column;
}

.bankruptcy-assets {
    flex-grow: 0;
    flex-shrink: 0;
    height: 72px;
    min-height: 72px;
    max-height: 72px;
    margin-top: 8px;
    margin-bottom: 8px;
}

.bankruptcy-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    margin-top: -72px;
}

.bankruptcy-footer--portrait {
    margin-top: 0;
}

.bankruptcy-title {
    color: var(--color-neon-red);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.bankruptcy-debt-line {
    color: var(--color-text-muted);
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.bankruptcy-debt-value {
    color: var(--color-neon-red);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.bankruptcy-asset-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    margin-bottom: 6px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(64, 65, 78, 0.5);
    background-color: rgba(26, 29, 39, 0.5);
}

.bankruptcy-asset-name {
    color: var(--color-text-white);
    font-size: 13px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.bankruptcy-asset-meta {
    color: var(--color-text-darker);
    font-size: 11px;
}

.bankruptcy-asset-btn {
    background-color: rgba(255, 71, 71, 0.18);
    color: var(--color-neon-red);
    border-width: 1px;
    border-color: rgba(255, 71, 71, 0.5);
    border-radius: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 11px;
    -unity-font-style: bold;
    min-height: 44px;
}

/* Base Panel */
.bottom-panel-container {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 100%;
    justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}

.bottom-panel-container.marketplace-modal {
    background-color: rgba(0, 0, 0, 0.6);
}

.bottom-panel-container.marketplace-nonmodal {
    background-color: rgba(0, 0, 0, 0);
}

.clickable {
}

.marketplace-panel {
    background-color: var(--color-panel-bg-top);
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-top-width: 1.5px;
    border-left-width: 1.5px;
    border-right-width: 1.5px;
    border-color: var(--color-panel-border);
    flex-direction: column;
    width: 100%;
    max-width: 760px;
    max-height: 58%;
    align-self: center;
}

/* Grab handle */
.indicator-row {
    height: 16px;
    justify-content: center;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 4px;
}

.indicator-pill {
    width: 40px;
    height: 5px;
    border-radius: 5px;
    background-color: var(--color-handle-pill);
}

/* Close/Header Button */
.btn-close {
    position: absolute;
    top: 6px;
    right: 8px;
    width: 44px;
    height: 44px;
    justify-content: center;
    align-items: center;
    background-color: transparent;
    border-width: 0;
}

.close-text {
    font-size: 24px;
    color: #6a7282;
    -unity-text-align: middle-center;
}

/* Header Text */
.panel-header-title {
    color: #c27aff;
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    letter-spacing: 1px;
}

/* Content Container */
.panel-content {
    padding-left: 16px;
    padding-right: 16px;
    padding-bottom: 20px;
    flex-direction: column;
    min-height: 0;
}

/* ----------- Layout Fragments & Expansion ----------- */

/* Side-by-side flex for Marketplace Main Hub */
.side-by-side-row {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
}

.tender-review-actions {
    flex-shrink: 0;
    margin-top: 16px;
}

.ux-compact-height #Panel_Marketplace_TenderReview .marketplace-panel--expanded {
    height: 92%;
}

.ux-compact-height #Panel_Marketplace_TenderReview .panel-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-bottom: 8px;
}

.ux-compact-height #Panel_Marketplace_TenderReview .scroll-list-container {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    max-height: none;
}

.ux-compact-height #Panel_Marketplace_TenderReview .tender-review-actions {
    margin-top: 8px;
}

.choice-column {
    flex-basis: 48%; /* Leaves 4% gap */
    flex-direction: column;
}

/* ScrollView Container */
.scroll-list-container {
    width: 100%;
    height: auto;
    max-height: 360px;
    min-height: 80px;
    flex-shrink: 1;
    flex-direction: column;
}

/* Choice Cards (Standard) */
.card-choice {
    width: 100%;
    border-radius: 20px;
    border-width: 1.5px;
    flex-direction: row;
    padding: 16px;
    align-items: flex-start;
    margin-bottom: 12px;
    -unity-text-align: middle-left;
    background-color: transparent;
    min-height: 72px;
}

/* Vertical Choice Card variant for Side-by-Side */
.card-choice-vertical {
    border-radius: 20px;
    border-width: 1.5px;
    flex-direction: column;
    padding: 16px;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
    height: 172px;
    min-height: 172px;
    max-height: 172px;
    flex-shrink: 0;
}

.card-choice-vertical .text-stack {
    flex-grow: 0;
}

/* Short landscape viewports: keep the hub actionable without hiding every board tile. */
.ux-compact-height .marketplace-panel {
    max-height: 72%;
}

.ux-compact-height .marketplace-panel--expanded {
    max-height: 92%;
}

.ux-compact-height .marketplace-panel.marketplace-panel--selection {
    max-height: 96px;
    min-height: 76px;
}

.ux-compact-height .indicator-row {
    height: 12px;
    padding-top: 8px;
    padding-bottom: 2px;
}

.ux-compact-height .panel-content {
    padding-bottom: 10px;
}

.ux-compact-height .panel-header-title {
    margin-bottom: 6px;
}

.ux-compact-height .card-choice-vertical {
    height: 132px;
    min-height: 132px;
    max-height: 132px;
    padding: 10px;
    margin-bottom: 6px;
}

.ux-compact-height .card-choice-vertical .icon-box {
    width: 44px;
    height: 44px;
    border-radius: 13px;
    margin-bottom: 6px;
}

.ux-compact-height .card-choice-vertical .card-title {
    font-size: 14px;
}

.ux-compact-height .card-choice-vertical .card-desc {
    font-size: 11px;
}

/* Phone portrait: preserve both decisions side by side without clipped copy. */
.ux-narrow .panel-content {
    padding-left: 10px;
    padding-right: 10px;
}

.ux-narrow .card-choice-vertical {
    padding: 8px;
}

.ux-narrow .card-choice-vertical .icon-box {
    width: 44px;
    height: 44px;
    border-radius: 13px;
    margin-bottom: 6px;
}

.ux-narrow .card-choice-vertical .card-title {
    font-size: 14px;
}

.ux-narrow .card-choice-vertical .card-desc {
    font-size: 10px;
}

.card-auction {
    background-color: var(--color-auction-bg);
    border-color: var(--color-auction-border);
}

.card-sanctions {
    background-color: var(--color-sanctions-bg);
    border-color: var(--color-sanctions-border);
}

/* Icons within cards */
.icon-box {
    width: 60px;
    height: 60px;
    border-radius: 18px;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.icon-box-left { margin-right: 16px; }
.icon-box-top { margin-bottom: 12px; }

.icon-auction-box { background-color: var(--color-auction-bg); }
.icon-sanctions-box { background-color: var(--color-sanctions-bg); }

.icon-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

#Icon_Auction { background-image: url("../Sprites/Icons/Icon_ChartAuction_Green.png"); }
#Icon_Sanctions { background-image: url("../Sprites/Icons/Icon_WrenchSanctions_Purple.png"); }
#Icon_Embargo { background-image: url("../Sprites/Icons/Icon_Embargo_Purple.png"); }
#Icon_Audit { background-image: url("../Sprites/Icons/Icon_Audit_Purple.png"); }
#Icon_Strike { background-image: url("../Sprites/Icons/Icon_Strike_Purple.png"); }
#Icon_Sabotage { background-image: url("../Sprites/Icons/Icon_Sabotage_Purple.png"); }

/* ────────────────────────────────────────────────────────────────
   TILE ICONS — Family & Special-Tile Glyphs (procedural, no assets)
   Composed at runtime by TileIconResolver.cs into an .icon-box /
   .icon-box--compact container. Tint = background-color of the box
   itself; glyph pieces are absolutely-positioned children in white.
   ──────────────────────────────────────────────────────────────── */

.icon-box--compact {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    margin-right: 12px;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.tile-icon--realestate  { background-color: rgba(59, 130, 246, 0.18); }
.tile-icon--pharma      { background-color: rgba(5, 223, 114, 0.18); }
.tile-icon--automobile  { background-color: rgba(255, 71, 71, 0.18); }
.tile-icon--oilgas      { background-color: rgba(245, 158, 11, 0.18); }
.tile-icon--luxe        { background-color: rgba(255, 215, 0, 0.18); }
.tile-icon--tech        { background-color: rgba(0, 255, 255, 0.18); }
.tile-icon--aerospace   { background-color: rgba(194, 122, 255, 0.18); }
.tile-icon--armement    { background-color: rgba(255, 71, 71, 0.24); }
.tile-icon--logistics   { background-color: rgba(138, 143, 154, 0.2); }

.tile-icon--go           { background-color: rgba(5, 223, 114, 0.18); }
.tile-icon--prison       { background-color: rgba(138, 143, 154, 0.2); }
.tile-icon--redirect     { background-color: rgba(245, 158, 11, 0.22); }
.tile-icon--auction      { background-color: var(--color-auction-bg); }
.tile-icon--safe         { background-color: rgba(0, 255, 255, 0.16); }
.tile-icon--tax          { background-color: rgba(138, 143, 154, 0.18); }
.tile-icon--venture      { background-color: var(--color-sanctions-bg); }
.tile-icon--casino       { background-color: rgba(255, 215, 0, 0.18); }
.tile-icon--stockmarket  { background-color: rgba(0, 255, 255, 0.2); }

.tile-icon--neutral      { background-color: rgba(138, 143, 154, 0.16); }

/* Glyph primitives — plain shapes, positioned/rotated per-glyph in C#. */
.glyph-piece {
    position: absolute;
    background-color: var(--color-text-white);
}

.glyph-bar { border-radius: 2px; }
.glyph-circle { border-radius: 50%; }

.glyph-ring {
    border-radius: 50%;
    border-width: 2px;
    border-color: var(--color-text-white);
    background-color: rgba(0, 0, 0, 0);
}

.glyph-outline {
    border-radius: 3px;
    border-width: 2px;
    border-color: var(--color-text-white);
    background-color: rgba(0, 0, 0, 0);
}

/* Property yield markers projected over the existing board anchors. */
.board-tile-yield-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.board-tile-yield-chip {
    position: absolute;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 12, 18, 0.88);
    border-width: 1px;
    border-color: rgba(120, 125, 145, 0.38);
    border-radius: 5px;
    padding: 1px;
}

.board-tile-yield-icon {
    margin-right: 0;
    border-radius: 3px;
    flex-shrink: 0;
}

.board-tile-yield-value {
    -unity-font: url("/Assets/UI/Fonts/Inter-700.ttf");
    color: #f5f6fa;
    font-size: 7px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.9);
}

/* ────────────────────────────────────────────────────────────────
   TILE DETAIL BOTTOM SHEET (TileDetail_BottomSheet.uxml)
   ──────────────────────────────────────────────────────────────── */

.tile-stat-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    padding-top: 12px;
    padding-bottom: 12px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(64, 65, 78, 0.4);
    margin-bottom: 16px;
}

.tile-stat-cell {
    flex-direction: column;
    align-items: flex-start;
    flex-grow: 1;
}

.tile-stat-label {
    color: var(--color-text-darker);
    font-size: 11px;
    margin-bottom: 2px;
    letter-spacing: 0.5px;
}

.tile-stat-value {
    color: var(--color-text-white);
    font-size: 16px;
    -unity-font-style: bold;
}

.tile-action-row {
    flex-direction: row;
    width: 100%;
}

.tile-action-btn {
    flex-grow: 1;
    -unity-text-align: middle-center;
    min-width: 0;
}

.tile-action-btn--primary {
    margin-right: 12px;
}

.tile-action-btn--secondary {
    margin-right: 12px;
}

/* Property inspector: one clear action, with a quieter outlined alternative. */
#Panel_TileDetail .card-title,
#Panel_TileDetail .tile-stat-value {
    -unity-font: url("/Assets/UI/Fonts/Inter-700.ttf");
}

#Panel_TileDetail .card-desc,
#Panel_TileDetail .tile-stat-label,
#Panel_TileDetail .tile-action-btn {
    -unity-font: url("/Assets/UI/Fonts/Inter-600.ttf");
}

#Panel_TileDetail .tile-family-badge {
    align-self: flex-start;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 8px;
    background-color: rgba(60, 63, 80, 0.45);
    font-size: 11px;
}

#Panel_TileDetail .tile-action-btn--primary {
    border-radius: 24px;
}

#Panel_TileDetail .tile-action-btn--secondary {
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(150, 157, 177, 0.65);
    border-radius: 24px;
    color: var(--color-text-muted);
}

/* Purchase confirmation: only the thumb moves, avoiding whole-Canvas rebuilds. */
#Panel_TileDetail .buy-slide-track {
    position: relative;
    height: 48px;
    min-height: 48px;
    background-color: rgba(9, 54, 37, 0.92);
    border-width: 1px;
    border-color: rgba(46, 184, 114, 0.7);
    border-radius: 24px;
    overflow: hidden;
    align-items: center;
    justify-content: center;
}
#Panel_TileDetail .buy-slide-label {
    color: #d8fbe7;
    font-size: 11px;
    -unity-font: url("/Assets/UI/Fonts/Inter-700.ttf");
    letter-spacing: 0.5px;
    margin-left: 38px;
    -unity-text-align: middle-center;
}
#Panel_TileDetail .buy-slide-handle {
    position: absolute;
    left: 3px;
    top: 3px;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: #35dd89;
    align-items: center;
    justify-content: center;
}
#Panel_TileDetail .buy-slide-chevron {
    color: #07351e;
    font-size: 19px;
    -unity-font: url("/Assets/UI/Fonts/Inter-700.ttf");
    -unity-text-align: middle-center;
}
#Panel_TileDetail .buy-slide-track:focus {
    border-width: 2px;
    border-color: var(--color-neon-cyan);
}

.marketplace-panel--selection {
    max-height: 112px;
    min-height: 88px;
}

.marketplace-panel--selection .panel-content {
    padding-top: 4px;
    padding-bottom: 10px;
}

.marketplace-panel--selection .panel-header-title {
    margin-bottom: 0;
    -unity-text-align: middle-center;
}

/* Texts in Cards */
.text-stack { flex-direction: column; flex-grow: 1; }
.text-stack-center { align-items: center; }

.card-title {
    color: var(--color-text-white);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    white-space: normal;
}

.card-desc {
    color: var(--color-text-muted);
    font-size: 14px;
    white-space: normal;
}

/* Sanction List Items */
.card-sanction-item {
    width: 100%;
    border-radius: 14px;
    border-width: 1.5px;
    border-color: var(--color-sanctions-border);
    background-color: var(--color-sanctions-bg-light);
    flex-direction: row;
    padding: 16px;
    align-items: center;
    margin-bottom: 12px;
    min-height: 56px;
}

.sanction-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background-color: var(--color-sanctions-bg);
    justify-content: center;
    align-items: center;
    margin-right: 16px;
    flex-shrink: 0;
}

.sanction-title {
    color: var(--color-text-white);
    font-size: 14px;
    -unity-font-style: bold;
}

.sanction-cost {
    color: var(--color-text-darker);
    font-size: 11px;
    margin-top: 2px;
}

.sanction-effect {
    color: var(--color-text-muted);
    font-size: 11px;
    margin-top: 2px;
    white-space: normal;
}

/* Bid Entry / Auction Item Component */
.card-bid-entry {
    border-radius: 16px;
    border-width: 1.5px;
    border-color: #6b6e71;
    background-color: rgba(26, 29, 39, 0.4);
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    margin-bottom: 8px;
}

.avatar-stack {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.avatar-box {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgba(255, 100, 103, 0.2); /* Fallback */
}

.player-name {
    color: var(--color-text-white);
    font-size: 10px;
    -unity-font: url("/Assets/UI/Fonts/Inter-600.ttf");
    margin-left: 8px;
    max-width: 88px;
    white-space: normal;
}

.vertical-divider {
    width: 1px;
    background-color: #3B3D4A;
    margin-left: 12px;
    margin-right: 12px;
    align-self: stretch; /* Fills height */
}

.offer-stack {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-grow: 1;
    justify-content: flex-end;
}

/* Tag Offers */
.tag-offer {
    border-radius: 10px;
    border-width: 1px;
    flex-direction: column;
    align-items: center;
    padding: 8px;
    margin-right: 8px;
}

.tag-purple {
    background-color: rgba(173, 70, 255, 0.15);
    border-color: rgba(173, 70, 255, 0.35);
}

.tag-green {
    background-color: rgba(0, 201, 80, 0.15);
    border-color: rgba(0, 201, 80, 0.35);
}

.tag-label {
    color: var(--color-text-white);
    font-size: 9px;
    -unity-font-style: bold;
    margin-top: 4px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.txt-price {
    color: #05df72;
    font-size: 12px;
    -unity-font-style: bold;
    margin-top: 2px;
}

/* ───────────────────────────────────────────── */
/* GLOW COHERENCE: Neon Glow Fade Class          */
/* ───────────────────────────────────────────── */

.neon-glow-active {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    /* This will be the 9-slice PNG assigned in Unity Inspector or via code */
    /* background-image: resource('Sprites/Frames/Frame_PurpleGlow_20px'); */
    -unity-background-scale-mode: stretch-to-fill;
    
    /* Fade transition states */
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

.neon-glow-active:hover {
    opacity: 1;
}

/* Add a helper class to forceglow */
.neon-glow-active.is-glowing {
    opacity: 1;
}

/* Bid Row: selected state (neon green border) */
.bid-selected {
    border-color: #05DF72 !important;
    border-width: 2px !important;
}

/* Seller property row (simplified layout for Tender Init) */
.card-seller-row {
    border-radius: 16px;
    border-width: 1.5px;
    border-color: rgba(5, 223, 114, 0.4);
    background-color: rgba(5, 223, 114, 0.08);
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    margin-bottom: 8px;
}

.seller-prop-name {
    color: var(--color-text-white);
    font-size: 14px;
    -unity-font-style: bold;
    flex-grow: 1;
    min-width: 0;
    white-space: normal;
}

.seller-prop-income {
    color: #05DF72;
    font-size: 12px;
    -unity-font-style: bold;
}

/* ═══════════════════════════════════════════════════
   BUTTONS
═══════════════════════════════════════════════════ */

/* Primary CTA — vert néon, coins arrondis */
.btn-standard {
    background-color: #05DF72;
    color: #000000;
    border-width: 0;
    border-radius: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 20px;
    padding-right: 20px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    min-height: 48px;
}

/* Secondary CTA — gris foncé */
.btn-secondary {
    background-color: rgba(60, 63, 80, 1);
    color: #d1d5dc;
    border-width: 1px;
    border-color: rgba(64, 65, 78, 1);
    border-radius: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 20px;
    padding-right: 20px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    min-height: 48px;
}

.btn-standard:hover, .btn-standard:focus {
    background-color: #35EE8F;
}

.btn-secondary:hover, .btn-secondary:focus {
    background-color: rgba(79, 83, 103, 1);
    border-color: rgba(194, 122, 255, 0.75);
}

.card-choice:hover, .card-choice:focus,
.card-choice-vertical:hover, .card-choice-vertical:focus,
.card-sanction-item:hover, .card-sanction-item:focus,
.player-select-card:hover, .player-select-card:focus,
.property-select-card:hover, .property-select-card:focus,
.card-bid-entry:hover, .card-bid-entry:focus {
    border-color: var(--color-neon-cyan);
}

.btn-close:hover, .btn-close:focus {
    background-color: rgba(255, 255, 255, 0.08);
}

.btn-close:hover .close-text, .btn-close:focus .close-text {
    color: var(--color-text-white);
}

.ux-interactive:focus {
    border-width: 2px;
    border-color: var(--color-neon-cyan);
}

.btn-standard:disabled, .btn-secondary:disabled {
    opacity: 0.42;
}

.bankruptcy-give-up-btn {
    height: 40px;
    min-height: 40px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 16px;
    padding-right: 16px;
    margin-top: 0;
    margin-bottom: 0;
}

.btn-remove {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    margin-left: 10px;
    padding: 0;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 71, 71, 0.6);
    background-color: rgba(255, 71, 71, 0.2);
    color: var(--color-neon-red);
    -unity-font-style: bold;
}

.btn-remove:hover, .btn-remove:focus {
    background-color: rgba(255, 71, 71, 0.35);
    border-color: var(--color-neon-red);
}

.empty-state-label {
    color: var(--color-text-darker);
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 20px 12px;
}

#Panel_Marketplace_TenderReview .empty-state-label,
#Panel_Marketplace_BidderSpectator .empty-state-label {
    align-self: stretch;
    min-height: 72px;
    margin-top: 12px;
    margin-bottom: 12px;
    padding: 20px 16px;
    border-width: 1px;
    border-color: rgba(112, 119, 139, 0.4);
    border-radius: 12px;
    background-color: rgba(35, 39, 53, 0.76);
    color: var(--color-text-muted);
    -unity-font: url("/Assets/UI/Fonts/Inter-500.ttf");
}

/* ═══════════════════════════════════════════════════
   PANEL HEIGHT VARIANTS
═══════════════════════════════════════════════════ */

/* Compact — hauteur pilotée par le contenu (pas de max-height fixe) */
.marketplace-panel--compact {
    max-height: 82%;
}

.investment-panel {
    width: 520px;
    max-width: 92%;
}

.ux-compact-height .investment-panel {
    max-height: 94%;
}

.ux-compact-height .investment-panel .panel-content {
    padding-bottom: 6px;
}

.ux-compact-height .investment-panel .panel-header-title {
    font-size: 14px;
    margin-bottom: 2px;
}

.ux-compact-height .investment-context {
    font-size: 11px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.ux-compact-height .investment-label {
    font-size: 9px;
    margin-top: 1px;
    margin-bottom: 1px;
    flex-shrink: 0;
}

.ux-compact-height .investment-option-row {
    margin-bottom: 3px;
    flex-shrink: 0;
}

.ux-compact-height .investment-panel .btn-standard,
.ux-compact-height .investment-panel .btn-secondary {
    min-height: 36px;
    padding-top: 5px;
    padding-bottom: 5px;
    font-size: 12px;
    flex-shrink: 0;
}

.ux-compact-height .investment-option-button {
    min-height: 32px;
    padding-top: 4px;
    padding-bottom: 4px;
    font-size: 11px;
}

.ux-compact-height .investment-risk {
    font-size: 9px;
    margin-top: 1px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.investment-context {
    color: var(--color-neon-cyan);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.investment-label {
    color: var(--color-text-darker);
    font-size: 10px;
    -unity-font-style: bold;
    margin-top: 4px;
    margin-bottom: 4px;
}

.investment-option-row {
    flex-direction: row;
    align-items: stretch;
    margin-bottom: 8px;
}

.investment-option-button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 42px;
    margin-left: 3px;
    margin-right: 3px;
}

.investment-option-button.card-selected {
    color: var(--color-neon-green);
    border-color: var(--color-neon-green);
    background-color: rgba(5, 223, 114, 0.14);
}

.investment-risk {
    color: var(--color-text-muted);
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 10px;
}

/* Expanded — pour les écrans avec longues listes */
.marketplace-panel--expanded {
    max-height: 88%;
}

.marketplace-panel.marketplace-panel--selection {
    max-height: 112px;
    min-height: 88px;
}

/* ═══════════════════════════════════════════════════
   WAITING / STATUS SCREENS
═══════════════════════════════════════════════════ */

.waiting-status-label {
    color: var(--color-text-darker);
    font-size: 13px;
    -unity-text-align: middle-center;
    margin-top: 12px;
    margin-bottom: 4px;
    white-space: normal;
}

.property-highlight-row {
    border-radius: 14px;
    border-width: 1.5px;
    border-color: rgba(5, 223, 114, 0.4);
    background-color: rgba(5, 223, 114, 0.08);
    flex-direction: row;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    margin-top: 8px;
    margin-bottom: 12px;
}

.spectator-footer-label {
    color: var(--color-text-darker);
    font-size: 12px;
    -unity-text-align: middle-center;
    margin-top: 8px;
    white-space: normal;
}

/* ═══════════════════════════════════════════════════
   PLAYER / PROPERTY SELECTION GRID (Frame 3.A)
═══════════════════════════════════════════════════ */

/* Card joueur — 2 colonnes */
.player-select-card {
    width: 48%;
    border-radius: 16px;
    border-width: 1.5px;
    border-color: rgba(64, 65, 78, 1);
    background-color: rgba(26, 29, 39, 0.6);
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    margin-bottom: 8px;
    min-height: 52px;
}

.player-select-card.card-selected {
    border-color: #05DF72;
    background-color: rgba(5, 223, 114, 0.08);
}

.player-avatar-circle {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    margin-right: 10px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}

.player-select-name {
    color: var(--color-text-white);
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.player-select-sub {
    color: var(--color-text-darker);
    font-size: 10px;
}

/* Card propriété — dans la sélection sanction */
.property-select-card {
    width: 100%;
    border-radius: 14px;
    border-width: 1.5px;
    border-color: rgba(64, 65, 78, 1);
    background-color: rgba(26, 29, 39, 0.6);
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    margin-bottom: 6px;
}

.property-select-card.card-selected {
    border-color: #c27aff;
    background-color: rgba(173, 70, 255, 0.08);
}

/* Bid details scroll independently while submission actions remain reachable. */
.bidder-panel { height: 82%; max-height: 92%; }
.bidder-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.bidder-actions { flex-shrink: 0; padding-left: 16px; padding-right: 16px; padding-bottom: 12px; }

.bidder-scroll .unity-scroll-view__content-container { width: 100%; min-width: 0; }
.bidder-scroll .unity-scroller--vertical { width: 12px; min-width: 12px; background-color: transparent; }
.bidder-scroll .unity-scroller #unity-low-button,
.bidder-scroll .unity-scroller #unity-high-button { display: none; }
.bidder-scroll .unity-scroller #unity-tracker { background-color: #242633; }
.bidder-scroll .unity-scroller #unity-dragger { background-color: #05DF72; border-radius: 6px; min-height: 24px; }
